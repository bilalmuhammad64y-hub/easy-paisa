<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>StackMarket Store</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <header class="site-header">
    <div class="container nav-wrap">
      <a href="html" class="brand" aria-label="stackmarket">
        <span class="brand-mark">E</span>
        <span class="brand-copy">
          <small>MARKET</small>
        </span>
      </a>

      <div class="search-box hidden-mobile">
        <input type="text" placeholder="Search products, brands and more" />
        <button><i class="fa-solid fa-magnifying-glass"></i></button>
      </div>

      <nav class="main-nav hidden-tablet">
        <a href="html">Home</a>
        <a href="products.html">Products</a>
        <a href="#offers">Offers</a>
        <a href="#reviews">Reviews</a>
      </nav>

      <div class="nav-actions">
        <a href="/customer/login" class="btn btn-light small-btn">Login</a>
        <a href="/customer/signup" class="btn btn-primary small-btn">Sign Up</a>
        <a href="cart.html" class="cart-button" aria-label="Cart">
          <i class="fa-solid fa-cart-shopping"></i>
          <span class="cart-count">0</span>
        </a>
        <a href="checkout.html" class="btn btn-primary">Checkout</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero-section">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Big sale is live in the USA</p>
          <h1>Shop smarter for premium tech, home, and lifestyle essentials.</h1>
          <p class="hero-text">Discover top-rated products with fast nationwide delivery, secure checkout, and trusted customer support across the United States.</p>

          <div class="hero-actions">
            <a href="products.html" class="btn btn-primary">Shop Now</a>
            <a href="/customer/signup" class="btn btn-light">Create Account</a>
          </div>

          <div class="stats-row">
            <div><strong>20k+</strong><span>Happy customers</span></div>
            <div><strong>4.9/5</strong><span>Average rating</span></div>
            <div><strong>24/7</strong><span>Support</span></div>
          </div>
        </div>

        <div class="hero-card-wrap">
          <div class="hero-card">
            <div class="hero-card-top">
              <span class="tag">Limited Offer</span>
              <span class="discount">UP TO 50%</span>
            </div>

            <div class="hero-card-body">
              <p class="small-label">Featured</p>
              <h2>Noise Cancelling Headphones</h2>
            </div>

            <div class="hero-product-row">
              <div>
                <p>Now</p>
                <strong>$129</strong>
              </div>
              <img src="https://images.unsplash.com/photo-1546435770-a3e426bf472b?auto=format&fit=crop&w=700&q=80" alt="Headphones" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="features container">
      <div class="feature-box">
        <span class="feature-icon blue"><i class="fa-solid fa-truck-fast"></i></span>
        <div>
          <h3>Free Delivery</h3>
          <p>On orders above $50</p>
        </div>
      </div>
      <div class="feature-box">
        <span class="feature-icon green"><i class="fa-solid fa-shield-heart"></i></span>
        <div>
          <h3>Secure Payment</h3>
          <p>100% protected checkout</p>
        </div>
      </div>
      <div class="feature-box">
        <span class="feature-icon amber"><i class="fa-solid fa-headset"></i></span>
        <div>
          <h3>24/7 Support</h3>
          <p>Always here for help</p>
        </div>
      </div>
    </section>

    <section id="offers" class="container pb-4">
      <div class="section-head">
        <h2>Shop by Category</h2>
        <a href="products.html">See all</a>
      </div>

      <div class="category-grid">
        <div class="category-card">
          <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=700&q=80" alt="Electronics" />
          <div>
            <h3>Electronics</h3>
            <p>Latest gadgets</p>
          </div>
        </div>
        <div class="category-card">
          <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=700&q=80" alt="Accessories" />
          <div>
            <h3>Accessories</h3>
            <p>Smart extras</p>
          </div>
        </div>
        <div class="category-card">
          <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=700&q=80" alt="Audio" />
          <div>
            <h3>Audio</h3>
            <p>Premium sound</p>
          </div>
        </div>
        <div class="category-card">
          <img src="https://images.unsplash.com/photo-1585386959984-a4155224a1ad?auto=format&fit=crop&w=700&q=80" alt="Home" />
          <div>
            <h3>Home</h3>
            <p>Comfort essentials</p>
          </div>
        </div>
      </div>
    </section>

    <section id="products" class="container section-space">
      <div class="section-head">
        <h2>Featured Products</h2>
      </div>

      <div class="product-grid" data-limit="0"></div>
    </section>

    <section class="container section-space">
      <div class="section-head">
        <h2>Featured Item</h2>
      </div>
      <div id="single-product" class="single-product"></div>
    </section>

    <section class="stats-banner">
      <div class="container stats-wrap">
        <div>
          <p class="eyebrow alt">Why choose us</p>
          <h2>Trusted by thousands of shoppers.</h2>
        </div>
        <div class="stats-grid">
          <div><strong>98%</strong><span>Customer satisfaction</span></div>
          <div><strong>15k+</strong><span>Products sold</span></div>
          <div><strong>1.2k</strong><span>Reviews</span></div>
          <div><strong>48h</strong><span>Fast delivery</span></div>
        </div>
      </div>
    </section>

    <section id="reviews" class="container section-space reviews-section">
      <div class="section-head center-head">
        <p class="eyebrow blue">Testimonials</p>
        <h2>What customers say</h2>
      </div>

      <div class="review-grid">
        <div class="review-card">
          <div class="stars">★★★★★</div>
          <p>“The quality is excellent and the delivery was super fast. I will definitely order again.”</p>
          <strong>Ayesha Khan</strong>
        </div>
        <div class="review-card">
          <div class="stars">★★★★★</div>
          <p>“Beautiful design and smooth checkout. The products feel premium and worth the price.”</p>
          <strong>Ali</strong>
        </div>
        <div class="review-card">
          <div class="stars">★★★★★</div>
          <p>“Very easy to shop, excellent support, and great deals on electronics. Highly recommended.”</p>
          <strong>Mariam Noor</strong>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <div class="brand footer-brand">
          <span class="brand-mark">E</span>
          <span>
            <strong>stackmarket</strong>
            <small>Market</small>
          </span>
        </div>
        <p>Your one-stop destination for premium tech and everyday essentials.</p>
      </div>
      <div>
        <h3>Company</h3>
        <ul>
          <li>About Us</li>
          <li>Contact</li>
          <li>Careers</li>
        </ul>
      </div>
      <div>
        <h3>Support</h3>
        <ul>
          <li>Help Center</li>
          <li>Shipping</li>
          <li>Returns</li>
        </ul>
      </div>
      <div>
        <h3>Follow Us</h3>
        <div class="socials">
          <i class="fa-brands fa-facebook-f"></i>
          <i class="fa-brands fa-instagram"></i>
          <i class="fa-brands fa-twitter"></i>
          <i class="fa-brands fa-youtube"></i>
        </div>
      </div>
    </div>
    <div class="container footer-bottom">© 2026 StackMarket. All rights reserved.</div>
  </footer>

  <script src="script.js"></script>
</body>
</html>

